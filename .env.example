# ==============================================================================
# Price Hunter - Arquivo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste com os valores do seu ambiente real.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME="Price Hunter"
APP_VERSION=1.0.0

# Portas de Acesso Externo no Servidor
WEB_PORT=8080
API_PORT=8000

# ------------------------------------------------------------------------------
# 2. Configurações do Banco de Dados
# ------------------------------------------------------------------------------
# MODALIDADE A: PostgreSQL Local em Docker
# Utilize caso queira rodar o PostgreSQL dentro do próprio servidor Docker / Portainer.
# Exemplo de string de conexão:
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_pwd_123@postgres:5432/pricehunter
POSTGRES_DB=pricehunter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd_123
DB_POOL_MODE=direct

# MODALIDADE B: Supabase Gerenciado Externo
# Caso prefira utilizar seu projeto Supabase, comente a linha do DATABASE_URL acima
# e utilize uma das opções de conexão abaixo fornecidas pelo painel do Supabase:
#
# Opção 1: Supabase Pooler - Modo Transaction (Recomendado para servidores em nuvem, porta 6543)
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DB_POOL_MODE=transaction
#
# Opção 2: Supabase Pooler - Modo Session (porta 5432)
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DB_POOL_MODE=session
#
# Opção 3: Conexão Direta ao PostgreSQL do Supabase (porta 5432)
# DATABASE_URL=postgresql+psycopg://postgres:[SUA-SENHA-SUPABASE]@db.[PROJECT-REF].supabase.co:5432/postgres
# DB_POOL_MODE=direct

# ------------------------------------------------------------------------------
# 3. Integração com APIs do Supabase (Opcional)
# ------------------------------------------------------------------------------
# Preencha se desejar usar Supabase Auth ou cliente direto Supabase no backend
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ATENÇÃO: NUNCA exponha a SERVICE_ROLE_KEY no frontend! Somente para o backend:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase
USE_SUPABASE_AUTH=false

# ------------------------------------------------------------------------------
# 4. Redis (Cache e Filas)
# ------------------------------------------------------------------------------
REDIS_URL=redis://:pricehunter_redis_secret@redis:6379/0
REDIS_PASSWORD=pricehunter_redis_secret
REDIS_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Telegram Bot (Alertas Instantâneos de Ofertas)
# ------------------------------------------------------------------------------
# Crie seu bot no Telegram conversando com @BotFather para obter o Token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
# Obtenha seu Chat ID conversando com @userinfobot
TELEGRAM_DEFAULT_CHAT_ID=123456789
TELEGRAM_ALERT_COOLDOWN_HOURS=24
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Segurança e Limites de Coleta
# ------------------------------------------------------------------------------
# Defina como false para ativar a proteção anti-SSRF rigorosa em produção
ALLOW_PRIVATE_IPS=false
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_SCRAPES=5
OPPORTUNITY_SCORE_MIN_THRESHOLD=70
DEFAULT_DISCOUNT_THRESHOLD_PCT=15.0
